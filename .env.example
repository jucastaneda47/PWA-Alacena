# Copia este archivo como ".env" y llena los valores. El ".env" real NO se sube a GitHub.

# Correo desde el que se envían los PIN y los enlaces de recuperación
EMAIL_SENDER=
# Contraseña de aplicación de Google (no la contraseña normal de la cuenta)
EMAIL_APP_PASSWORD=
# Dirección del frontend (en producción, la de Vercel)
FRONTEND_URL=http://localhost:5173
# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Base de datos. Déjala vacía en tu computador (usa el archivo db.sqlite3).
# En producción, la URL de PostgreSQL que entrega el proveedor, por ejemplo:
#   postgresql://usuario:clave@servidor:5432/nombre_base
DATABASE_URL=
